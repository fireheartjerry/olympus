[Unit]
Description=Create and locally verify an Olympus authority PostgreSQL backup
After=network-online.target docker.service olympus-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/home/ubuntu/olympus
ExecStart=/home/ubuntu/olympus/scripts/postgres-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/olympus-backups
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

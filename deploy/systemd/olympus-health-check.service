[Unit]
Description=Check Olympus authority services and capacity bounds
After=olympus-gateway.service olympus-audit-export.timer olympus-temporal-backup.timer

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/olympus
ExecStart=/home/ubuntu/olympus/scripts/production-health-check.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

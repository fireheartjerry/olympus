[Unit]
Description=Olympus production authority gateway (Face ID enrollment)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/home/ubuntu/olympus
ExecStart=/home/ubuntu/olympus/.venv/bin/python -m olympus.runtime.production_gateway
Restart=on-failure
RestartSec=3
# The gateway reads .env.production from its working directory; that file holds
# the database credential and is never world-readable.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
TasksMax=256
MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=default.target

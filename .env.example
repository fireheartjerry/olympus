OLYMPUS_ENVIRONMENT=development
OLYMPUS_DEV_COMMAND_TOKEN=development-only-token-change-before-use
OLYMPUS_TEMPORAL_ADDRESS=127.0.0.1:7233
OLYMPUS_TEMPORAL_TASK_QUEUE=olympus-command-v1
OLYMPUS_HTTP_HOST=127.0.0.1
OLYMPUS_HTTP_PORT=8080

# Production authority settings are intentionally nonfunctional placeholders.
# Use a separate ignored .env.production; never commit credentials or live scope.
OLYMPUS_PRODUCTION_COMMANDER_ID=628053765181800448
OLYMPUS_PRODUCTION_DISCORD_APPLICATION_PUBLIC_KEY=replace-with-64-hex-characters
OLYMPUS_PRODUCTION_DISCORD_GUILD_ID=replace-with-discord-guild-id
OLYMPUS_PRODUCTION_DISCORD_CHANNEL_IDS=["replace-with-agent-ops-channel-id"]
OLYMPUS_PRODUCTION_WEBAUTHN_ORIGIN=https://replace-with-private-tailscale-dns-name
OLYMPUS_PRODUCTION_WEBAUTHN_RP_ID=replace-with-private-tailscale-dns-name
OLYMPUS_PRODUCTION_DATABASE_DSN=postgresql+asyncpg://replace-with-runtime-secret
OLYMPUS_PRODUCTION_EMERGENCY_LATCH_PATH=/var/lib/olympus/emergency-freeze.json
OLYMPUS_PRODUCTION_EMERGENCY_LATCH_VERIFICATION_KEY=replace-with-64-hex-characters

# Execution-node mesh. Nodes dial out to this gateway; nothing dials a node.
OLYMPUS_NODE_MESH_ENABLED=false
OLYMPUS_NODE_TASK_QUEUE=olympus-node-edge-v1
OLYMPUS_NODE_HEARTBEAT_INTERVAL_SECONDS=15
OLYMPUS_NODE_HEARTBEAT_EXPIRY_SECONDS=45
OLYMPUS_NODE_ENROLLMENT_TTL_SECONDS=900
OLYMPUS_NODE_CONTROL_PLANE_KEY_ID=olympus-control-plane-v1
# The control-plane host enrolls itself as an execution node holding only
# system.inspect@1. Set to false to run the mesh with no self node.
OLYMPUS_NODE_ATTACH_CONTROL_PLANE_HOST=true
OLYMPUS_NODE_CONTROL_PLANE_HOST_NAME=vps-primary
# Generate with:
#   uv run python -c "from olympus.nodes.crypto import generate_node_keypair as g; print(g().private_key)"
# Leaving this empty generates an ephemeral key at startup, which forces every
# already-enrolled node to re-enroll. Never commit a real value.
OLYMPUS_NODE_CONTROL_PLANE_PRIVATE_KEY=

# PostgreSQL is the canonical owner of node-mesh registry, enrollment, job,
# and audit state. Leave this unset to run on the in-process store, which
# loses every node, grant, revocation, freeze, and audit event on restart.
# The node edge logs which store it chose at startup.
OLYMPUS_DATABASE_URL=
